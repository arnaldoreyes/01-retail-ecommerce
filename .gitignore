# =========================================================
# .gitignore
# =========================================================

# --- Datos: el original y los exportados no se versionan ---
data/raw/*
!data/raw/README.md
data/limpio/*
!data/limpio/.gitkeep

# --- Carpeta de trabajo personal ---
misc/

# --- Bases de datos locales ---
*.mdf
*.ldf
*.bak
*.db
*.sqlite
*.sqlite3
*.duckdb
*.accdb
*.parquet

# --- Excel y Power BI: archivos temporales ---
~$*.xlsx
~$*.xls
~$*.pbix
*.pbix.bak
**/.pbi/
**/.pbi/localSettings.json
*.tmp

# --- Salidas pesadas ---
*.zip
*.csv.gz
*.7z

# --- Sistema operativo y editores ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/settings.json
.idea/

# --- Secretos ---
.env
*.env
*.pem
secrets/
